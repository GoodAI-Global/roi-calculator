{
  "name": "@goodai/roi-calculator",
  "private": true,
  "version": "0.1.0",
  "description": "AI Implementation ROI Calculator by Good AI - Transparent, evidence-based ROI calculations",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "roi",
    "calculator",
    "ai",
    "manufacturing",
    "insurance",
    "enterprise",
    "goodai"
  ],
  "author": "Good AI <contact@wearegoodai.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoodAI-Global/roi-calculator.git"
  },
  "bugs": {
    "url": "https://github.com/GoodAI-Global/roi-calculator/issues"
  },
  "homepage": "https://github.com/GoodAI-Global/roi-calculator#readme",
  "engines": {
    "node": ">=18"
  }
}
