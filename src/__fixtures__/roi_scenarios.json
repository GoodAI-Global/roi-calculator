  "financial": {
    "description": "Financial metrics test scenarios",
    "scenarios": [
      {
        "id": "fin-npv-basic",
        "name": "Basic NPV Calculation",
        "description": "Simple NPV with constant cash flows",
        "inputs": {
          "initialInvestment": 100000,
          "monthlyCashFlow": 10000,
          "months": 24,
