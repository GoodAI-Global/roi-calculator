          "npv": "positive",
          "comments": [
            "monthlyRate = (1 + 0.10)^(1/12) - 1 ≈ 0.00797",
            "NPV = -100000 + Σ(10000 / (1.00797)^t) for t=1 to 24",
            "With constant 10k/month for 24 months at 10% annual, NPV should be positive"
          ]
        }
      },
      {
        "id": "fin-irr-convergence",
        "name": "IRR Convergence Test",
        "description": "Verify Newton-Raphson converges",
        "inputs": {
          "initialInvestment": 50000,
          "monthlyCashFlow": 5000,
          "months": 12
        },
        "expectedOutputs": {
          "irrConverges": true,
          "irrPositive": true,
          "comments": [
            "With 5k/month for 12 months = 60k total on 50k investment",
            "IRR should converge and be positive (profitable investment)"
          ]
        }
      },
      {
        "id": "fin-tco-inflation",
        "name": "TCO with Inflation",
        "description": "Verify inflation adjustment in TCO",
        "inputs": {
          "initialInvestment": 100000,
          "monthlyMaintenanceCost": 1000,
          "analysisYears": 5,
          "inflationRate": 0.03
        },
        "expectedOutputs": {
          "year0Cost": 12000,
          "year1Cost": 12360,
          "year2Cost": 12730.8,
          "year3Cost": 13112.72,
          "year4Cost": 13506.1,
          "totalMaintenance": 63709.62,
          "tco": 163709.62,
          "comments": [
            "Year 0: 1000 × 12 = 12000",
            "Year 1: 1000 × (1.03)^1 × 12 = 12360",
            "Year 2: 1000 × (1.03)^2 × 12 = 12730.80",
            "Year 3: 1000 × (1.03)^3 × 12 = 13112.72",
            "Year 4: 1000 × (1.03)^4 × 12 = 13506.10",
            "Total Maintenance = 63709.62",
            "TCO = 100000 + 63709.62 = 163709.62"
          ]
        }
      },
      {
        "id": "fin-profitability-index",
        "name": "Profitability Index",
        "description": "PI = (NPV + Investment) / Investment",
        "inputs": {
          "initialInvestment": 100000,
          "npv": 50000
        },
        "expectedOutputs": {
          "profitabilityIndex": 1.5,
          "interpretation": "Investment generates 50% more value than cost",
          "comments": ["PI = (50000 + 100000) / 100000 = 1.5", "PI > 1 indicates value creation"]
        }
      }
    ]
